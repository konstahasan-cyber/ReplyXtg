# ─── Site ──────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://aureliagrove.example

# Demo mode keeps every lead inside the browser + server validation only.
# Leave "true" for the concept site. Set to "false" ONLY for a real, licensed
# company after the CRM/email adapters below are configured.
NEXT_PUBLIC_DEMO_MODE=true

# ─── A/B experiments ───────────────────────────────────────────────────
# "true" enables sticky cookie-based variants (pages render dynamically).
EXPERIMENTS_ENABLED=false

# ─── Analytics (loaded only after consent, never in demo mode) ─────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# ─── Lead delivery (server only, ignored while demo mode is on) ────────
# Generic CRM webhook (HubSpot / Pipedrive / Zapier / Make / custom).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
# Transactional email via Resend-compatible HTTP API.
RESEND_API_KEY=
LEADS_NOTIFY_TO=
LEADS_NOTIFY_FROM=
